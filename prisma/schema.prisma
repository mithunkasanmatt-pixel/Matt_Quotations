datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("staff")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  companyName String?  @map("company_name")
  email       String
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("clients")
}

model Project {
  id              Int       @id @default(autoincrement())
  clientId        Int       @map("client_id")
  name            String
  type            String
  description     String?
  platform        String
  status          String    @default("Quotation Draft")
  priority        String    @default("Medium")
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  assignedUserId  Int?      @map("assigned_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("projects")
}

model Quotation {
  id              Int      @id @default(autoincrement())
  clientName      String   @map("client_name")
  place           String
  sirMadam        String   @map("sir_madam")
  quotationTitle  String   @map("quotation_title")
  technology      String
  duration        String
  amount          Decimal  @db.Decimal(12, 2)
  quotationNumber String   @unique @map("quotation_number")
  quotationDate   DateTime @default(now()) @map("quotation_date")
  validUntil      DateTime @map("valid_until")
  status          String   @default("Generated")
  notes           String?
  phase           String   @default("Phase 1")
  parentQuotationId Int?     @map("parent_quotation_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  parentQuotation Quotation?  @relation("QuotationPhaseHistory", fields: [parentQuotationId], references: [id], onDelete: SetNull)
  childQuotations Quotation[] @relation("QuotationPhaseHistory")
  titles          QuotationTitle[]

  @@map("quotations")
}

model QuotationTitle {
  id          Int      @id @default(autoincrement())
  quotationId Int      @map("quotation_id")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  points      QuotationPoint[]

  @@map("quotation_titles")
}

model QuotationPoint {
  id        Int      @id @default(autoincrement())
  titleId   Int      @map("title_id")
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title     QuotationTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@map("quotation_points")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  userId      Int      @map("user_id")
  userName    String   @map("user_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
